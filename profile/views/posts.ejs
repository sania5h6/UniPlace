<!DOCTYPE html>
<html>
<head>
  <title><%= type.charAt(0).toUpperCase() + type.slice(1) %> Posts</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
</head>
<body class="p-4">
  <h2><%= type.charAt(0).toUpperCase() + type.slice(1) %> Posts</h2>
  <a href="/dashboard" class="btn btn-secondary mb-3">⬅ Back to Dashboard</a>

  <% if (posts.length === 0) { %>
    <p>No posts yet in this section.</p>
  <% } else { %>
    <% posts.forEach(post => { %>
      <div class="card mb-3">
        <div class="card-body">
          <h5 class="card-title"><%= post.title %></h5>
          <% if (post.company) { %>
            <p><strong>Company:</strong> <%= post.company %></p>
          <% } %>
          <% if (post.domain) { %>
            <p><strong>Domain:</strong> <%= post.domain %></p>
          <% } %>
          <% if (post.date) { %>
            <p><strong>Date:</strong> <%= post.date %></p>
          <% } %>
          <p><%= post.content %></p>
          <small class="text-muted">Posted by <%= post.postedBy %> — <%= moment(post.createdAt).fromNow() %></small>
        </div>
      </div>
    <% }) %>
  <% } %>
</body>
</html>