<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Help & Support</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body class="p-8 bg-gray-100">
    <div class="max-w-3xl mx-auto bg-white shadow-lg rounded-lg p-6">
        <h1 class="text-3xl font-bold mb-6">Help & Support</h1>
