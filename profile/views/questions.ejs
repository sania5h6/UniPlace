<!DOCTYPE html>
<html>
<head>
  <title>Placement Questions</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <h1>Answer Placement Questions</h1>
  <form action="/submit-answers" method="POST">
    <input type="hidden" name="email" value="<%= email %>">

    <% questions.forEach((q, i) => { %>
      <div>
        <label><%= q %></label><br>
        <textarea name="answer_<%= i %>" rows="3" cols="50" required></textarea>
      </div><br>
    <% }) %>

    <button type="submit">Submit Answers</button>
  </form>
</body>
</html>