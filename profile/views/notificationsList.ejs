<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>All Placement Notifications</title>
  <link rel="stylesheet" href="/styles.css">
  <style>
    body {
      font-family: Arial, sans-serif;
      margin: 0;
      padding: 0;
      background: #f4f6f9;
    }
    header {
      background: #0078d7;
      color: white;
      padding: 15px;
      text-align: center;
    }
    h1 {
      margin: 0;
      font-size: 24px;
    }
    .container {
      max-width: 900px;
      margin: 30px auto;
      padding: 20px;
      background: #fff;
      border-radius: 10px;
      box-shadow: 0 4px 8px rgba(0,0,0,0.1);
    }
    .notification {
      padding: 15px;
      border-bottom: 1px solid #ddd;
    }
    .notification:last-child {
      border-bottom: none;
    }
    .notification h3 {
      margin: 0;
      font-size: 18px;
      color: #333;
    }
    .notification p {
      margin: 5px 0;
      color: #555;
    }
    .notification small {
      color: gray;
      font-size: 12px;
    }
    .back-btn {
      display: inline-block;
      margin-top: 20px;
      padding: 8px 15px;
      background: #0078d7;
      color: white;
      text-decoration: none;
      border-radius: 5px;
      transition: 0.3s;
    }
    .back-btn:hover {
      background: #005a9e;
    }
  </style>
</head>
<body>
  <header>
    <h1>📢 All Placement Notifications</h1>
  </header>

  <div class="container">
    <% if (notifications.length > 0) { %>
      <% notifications.forEach(n => { %>
        <div class="notification">
          <h3><%= n.title %> - <%= n.company %></h3>
          <p><strong>Domain:</strong> <%= n.domain %></p>
          <p><%= n.description %></p>
          <% if (n.date) { %>
            <p><strong>Date:</strong> <%= n.date %></p>
          <% } %>
          <small>Posted <%= n.timeAgo %></small>
        </div>
      <% }) %>
    <% } else { %>
      <p>No notifications available.</p>
    <% } %>

    <a href="/dashboard?email=<%= email %>" class="back-btn">⬅ Back to Dashboard</a>
  </div>
</body>
</html>
